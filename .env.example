# Reverse image search. The pipeline uses whichever backends are configured and
# reports which engine(s) found each result.
#
# SERPAPI_KEY drives TWO backends off one key and one quota: Google Lens and
# Yandex images. They are separate crawls, so a page both return is genuine
# corroboration rather than one index asked twice.
SERPAPI_KEY=

# Optional third backend, fully independent of SerpApi. Note that Cloud Vision
# requires billing enabled on the GCP project even inside the 1,000/month free
# tier; without it every call returns 403 BILLING_DISABLED. Leave blank to
# disable the backend cleanly.
GOOGLE_VISION_API_KEY=

# Blockchain. Sepolia is a public testnet, so the anchor lands somewhere a judge
# can independently open in a block explorer rather than trusting our output.
#   sepolia     : https://ethereum-sepolia-rpc.publicnode.com   (chain 11155111)
#   local anvil : http://127.0.0.1:8545
#   memory      : in-process EVM, no node needed, but it dies with the process
#                 so it cannot demonstrate cross-process re-verification
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# A THROWAWAY testnet key. Never put a key here that holds real funds.
# Fund the matching address from a Sepolia faucet; a few thousandths of a
# testnet ETH is far more than one anchor transaction costs.
PRIVATE_KEY=
