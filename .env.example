# Reverse image search -- set one or both. The pipeline uses whichever is present
# and reports which engine(s) found each result.
SERPAPI_KEY=
GOOGLE_VISION_API_KEY=

# Blockchain. "memory" runs an in-process chain (no node, no faucet) but does not
# persist between runs. For the submission recording use a persistent node or a
# public testnet so re-verification can be shown as a separate command:
#   local anvil : http://127.0.0.1:8545
#   sepolia     : https://ethereum-sepolia-rpc.publicnode.com
RPC_URL=memory
PRIVATE_KEY=
