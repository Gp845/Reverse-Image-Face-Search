# Reverse image search -- set one or both. The pipeline uses whichever is present
# and reports which engine(s) found each result.
SERPAPI_KEY=
GOOGLE_VISION_API_KEY=

# Blockchain. Sepolia is a public testnet, so the anchor lands somewhere a judge
# can independently open in a block explorer rather than trusting our output.
#   sepolia     : https://ethereum-sepolia-rpc.publicnode.com   (chain 11155111)
#   local anvil : http://127.0.0.1:8545
#   memory      : in-process EVM, no node needed, but it dies with the process
#                 so it cannot demonstrate cross-process re-verification
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# A THROWAWAY testnet key. Never put a key here that holds real funds.
# Fund the matching address from a Sepolia faucet; a few thousandths of a
# testnet ETH is far more than one anchor transaction costs.
PRIVATE_KEY=
